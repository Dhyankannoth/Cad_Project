# ==============================================================================
# Chronodoc Monorepo - Unified Environment Configuration Template
# Copy this file to .env in your root directory or respective package directories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Documentation Agent Configuration (packages/agent)
# ------------------------------------------------------------------------------
# Primary LLM Provider: "openai" | "gemini" | "anthropic" | "mock"
LLM_PROVIDER=gemini

# Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Selection
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.2
MAX_TOKENS=4096

# Pipeline & Retry Limits
CHRONODOC_MAX_REVISION_ATTEMPTS=2
CHRONODOC_TOKEN_BUDGET=8000
CHRONODOC_LOG_LEVEL=info
CHRONODOC_CACHE_DIR=.chronodoc/cache

# ------------------------------------------------------------------------------
# 2. Web GUI Configuration (packages/web)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
