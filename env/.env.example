# Primary LLM Provider: "openai" | "gemini" | "anthropic" | "mock"
LLM_PROVIDER=openai

# --- Provider API Keys (Configure the ones you use) ---
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Model Selection ---
# Generation model for Agent 1 (Document Generator) and Agent 2 (Validator)
LLM_MODEL=gpt-4o-mini
# Embedding model for Hybrid RAG semantic retrieval
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.2
MAX_TOKENS=4096

# --- Pipeline & Retry Limits ---
# Maximum revision attempts for validation failures (per architecture spec: max 2)
CHRONODOC_MAX_REVISION_ATTEMPTS=2
# Context Builder token budget ceiling
CHRONODOC_TOKEN_BUDGET=8000
# Logging verbosity: "debug" | "info" | "warn" | "error"
CHRONODOC_LOG_LEVEL=info
# Local cache directory for AST symbols and embeddings
CHRONODOC_CACHE_DIR=.chronodoc/cache
